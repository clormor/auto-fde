{
  "manifest_version": 3,
  "name": "AI FDE AutoAllow",
  "version": "1.0.1",
  "description": "Clicks Allow prompts in a Foundry AI FDE session, keeps the tab awake, and resumes after network errors.",
  "permissions": ["scripting"],
  "host_permissions": ["https://*.palantirfoundry.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Start AutoAllow",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "start-autoallow": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Start AutoAllow on the current AI FDE session"
    }
  }
}
